#!/bin/bash
# Debian VM Clone First-Boot Setup - Safe Minimal + Hostname
# Run as normal user (uses sudo when needed)

set -euo pipefail

echo "=== Debian VM Clone Setup ==="

# === Set New Hostname ===
if [ -z "$1" ]; then
    read -p "Enter new short hostname: " NEW_HOSTNAME
else
    NEW_HOSTNAME="$1"
fi

if [ -z "$NEW_HOSTNAME" ]; then
    echo "Error: Hostname cannot be empty"
    exit 1
fi

echo "Setting hostname to: $NEW_HOSTNAME"
sudo hostnamectl set-hostname "$NEW_HOSTNAME"

# Update /etc/hosts (preserves existing domain if set)
echo "Updating /etc/hosts..."
sudo sed -i "s/127.0.1.1.*/127.0.1.1\t$NEW_HOSTNAME/" /etc/hosts

# === Regenerate SSH Host Keys ===
echo "Regenerating SSH host keys..."
sudo rm -f /etc/ssh/ssh_host_* || true
sudo dpkg-reconfigure openssh-server -f noninteractive
sudo systemctl restart ssh

# === Regenerate Machine ID ===
echo "Regenerating machine-id..."
sudo rm -f /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null || true
sudo systemd-machine-id-setup

echo
echo "=== Setup Complete! ==="
echo "New hostname : $NEW_HOSTNAME"
echo "Please reboot the system."
read -p "Reboot now? (y/N): " REBOOT

if [[ "$REBOOT" =~ ^[Yy]$ ]]; then
    echo "Rebooting..."
    sudo reboot
fi