#!/usr/bin/env bash

(
  cd /tmp
  curl -OL https://repo.zabbix.com/zabbix/8.0/release/debian/pool/main/z/zabbix-release/zabbix-release_latest_8.0+debian13_all.deb
  sudo dpkg -i zabbix-release_latest_8.0+debian13_all.deb
  sudo apt update
)

sudo apt install -y zabbix-server-pgsql zabbix-frontend-php php8.4-pgsql zabbix-nginx-conf zabbix-sql-scripts zabbix-agent2
sudo apt install -y zabbix-agent2-plugin-mongodb zabbix-agent2-plugin-mssql zabbix-agent2-plugin-postgresql

# Install and configure PostgreSQL for Zabbix database
sudo apt install -y postgresql
sudo systemctl status postgresql

sudo -u postgres createuser --pwprompt zabbix
sudo -u postgres createdb -O zabbix zabbix

zcat /usr/share/zabbix/sql-scripts/postgresql/server.sql.gz | sudo -u zabbix psql zabbix

# Configure Zabbix server to use the PostgreSQL database
echo "Edit /etc/zabbix/zabbix_server.conf to set the DBPassword if not already set"
echo "After editing the configuration, restart and enable the services:"
echo "sudo systemctl restart zabbix-server zabbix-agent2 nginx php8.4-fpm"
echo "sudo systemctl enable zabbix-server zabbix-agent2 nginx php8.4-fpm"