#!/bin/bash
# Change the system hostname and update /etc/hosts
# Usage: hostname [new-hostname]   (prompts if not given)
# Run as normal user

set -euo pipefail

echo "Args: $@"

OLD_HOSTNAME=$(command hostname)
NEW_HOSTNAME="${1:-}"
if [ -z "$NEW_HOSTNAME" ]; then
    echo "Hostname: $OLD_HOSTNAME"
    read -p "Enter new hostname (press Enter to keep current): " NEW_HOSTNAME
fi

if [ -z "$NEW_HOSTNAME" ]; then
    echo "No hostname entered. Keeping current hostname."
    exit 0
fi

echo "Setting hostname to: $NEW_HOSTNAME"
sudo hostnamectl set-hostname "$NEW_HOSTNAME"

# Update /etc/hosts: replace every occurrence of the old hostname
echo "Updating /etc/hosts ($OLD_HOSTNAME -> $NEW_HOSTNAME)..."
OLD_ESCAPED=$(printf '%s' "$OLD_HOSTNAME" | sed 's/[.[\*^$/]/\\&/g')
[ "$OLD_HOSTNAME" != "$NEW_HOSTNAME" ] && sudo sed -i -E ":a; s/(^|[[:space:]])${OLD_ESCAPED}([.[:space:]]|$)/\1${NEW_HOSTNAME}\2/; ta" /etc/hosts

# Ensure a 127.0.1.1 entry exists for the new hostname
if ! grep -qE "^127\.0\.1\.1[[:space:]].*\b${NEW_HOSTNAME}\b" /etc/hosts; then
    echo -e "127.0.1.1\t$NEW_HOSTNAME" | sudo tee -a /etc/hosts >/dev/null
fi
