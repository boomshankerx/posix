#!/usr/bin/env bash

[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
file=/usr/share/kali-themes/xfce4-panel-genmon-vpnip.sh
patch=$(cat <<'EOF'
--- a
+++ b
@@ -3 +3,2 @@
-[ -z "$interface" ] && interface="$(ip tuntap show | cut -d : -f1 | head -n 1)"
+[ -z "$interface" ] && interface="$(ip -o link show up \
+        | awk '/link\/none/ {sub(/:$/,"",$2); print $2; exit}')"
EOF
)

if patch --dry-run -R -s -f -l -F3 "$file" <<<"$patch" >/dev/null 2>&1; then
    echo "Patch already applied: $file"
    exit 0
fi
patch -b -l -F3 "$file" <<<"$patch"
